# ---------- Backend (backend/) ----------
# Supabase: Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DB_POOL_MAX=5                       # keep small on serverless; pooler multiplexes connections
PORT=4000
# Comma-separated list of browser origins allowed to make state-changing requests (CSRF check).
ALLOWED_ORIGINS=https://www.moonstarpower.com
# One-time bootstrap used by `npm run db:migrate` (first Super Admin). Remove after first run.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator
# Local demo only (placeholder prices + demo users). NEVER set in production.
# SEED_DEMO=1

# ---------- Frontend (frontend/) ----------
# Server-side URL of the API. The browser never calls it directly: /api/* is proxied by Next.js.
BACKEND_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=https://www.moonstarpower.com
